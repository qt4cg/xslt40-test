<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="switch">
   <description>Tests xsl:switch (new in XSLT 4.0)</description>
 

   <test-case name="switch-001">
      <description>Basic test of xsl:switch with select attributes</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-001.xsl"/>
      </test>
      <result>
         <assert>/out = 'Twenty-first'</assert>
      </result>
   </test-case>
   
   <test-case name="switch-002">
      <description>Basic test of xsl:switch with sequence constructors</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-002.xsl"/>
      </test>
      <result>
         <assert>/out = 'Twenty-first'</assert>
      </result>
   </test-case>
   
   <test-case name="switch-003">
      <description>xsl:switch with multiple values in one xsl:when</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-003.xsl"/>
      </test>
      <result>
         <assert>/out = 'Twenty-first'</assert>
      </result>
   </test-case>
   
   <test-case name="switch-004">
      <description>xsl:switch taking the xsl:otherwise path</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-004.xsl"/>
      </test>
      <result>
         <assert>/out = 'Umpteenth'</assert>
      </result>
   </test-case>
   
   <test-case name="switch-005">
      <description>xsl:switch omitting xsl:otherwise</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-005.xsl"/>
      </test>
      <result>
         <assert>empty(/out/node())</assert>
      </result>
   </test-case>
   
   <test-case name="switch-006">
      <description>xsl:fallback is ignored</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-006.xsl"/>
      </test>
      <result>
         <assert>empty(/out/node())</assert>
      </result>
   </test-case>
   
   <test-case name="switch-007">
      <description>xsl:fallback is ignored</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-007.xsl"/>
      </test>
      <result>
         <assert>empty(/out/node())</assert>
      </result>
   </test-case>
   
   <test-case name="switch-007a">
      <description>xsl:fallback is invoked in 3.0 mode</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT20 XSLT30"/>
      </dependencies>
      <test>
         <stylesheet file="switch-007.xsl"/>
      </test>
      <result>
         <assert>out = "NineteenthTwentieth"</assert>
      </result>
   </test-case>
   
   
   <test-case name="switch-901">
      <description>xsl:fallback must come last</description>
      <created by="Michael Kay" on="2021-01-01"/>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="switch-901.xsl"/>
      </test>
      <result>
         <error code="XTSE0010"/>
      </result>
   </test-case>
   
   <test-case name="switch-902">
      <description>Rejected by 3.0 processor if no fallback</description>
      <created by="Michael Kay" on="2023-08-05"/>
      <dependencies>
         <spec value="XSLT20 XSLT30"/>
      </dependencies>
      <test>
         <stylesheet file="switch-902.xsl"/>
      </test>
      <result>
         <error code="XTSE0010"/>
      </result>
   </test-case>

   <test-case name="switch-008">
      <description>Overlapping status alternatives select the first match and do not evaluate later tests.</description>
      <created by="Charles Korthout" on="2026-10-12"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-008.xsl"/></test>
      <result><assert-xml><![CDATA[<out>first</out>]]></assert-xml></result>
   </test-case>
   <test-case name="switch-009">
      <description>A matching empty-result branch ends selection instead of falling through.</description>
      <created by="Charles Korthout" on="2026-10-12"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-009.xsl"/></test>
      <result><assert-xml><![CDATA[<out count="0"/>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-010">
      <description>A singleton selector node is atomized before numeric general comparison.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-010.xsl"/></test>
      <result><assert-xml><![CDATA[<out>42</out>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-011">
      <description>An empty selector cannot satisfy the required single atomic item.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-011.xsl"/></test>
      <result><error code="XPTY0004"/></result>
   </test-case>

   <test-case name="switch-012">
      <description>Selector node atomization must still produce only one atomic item.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-012.xsl"/></test>
      <result><error code="XPTY0004"/></result>
   </test-case>

   <test-case name="switch-013">
      <description>A node-valued test sequence is atomized before general comparison.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-013.xsl"/></test>
      <result><assert-xml><![CDATA[<out>42</out>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-014">
      <description>NaN does not equal NaN and the otherwise branch is selected.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-014.xsl"/></test>
      <result><assert-xml><![CDATA[<out>42</out>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-015">
      <description>QName comparison uses expanded names rather than prefix spelling or local name alone.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-015.xsl"/></test>
      <result><assert-xml><![CDATA[<out>42</out>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-016">
      <description>Switch collation governs branch comparison even with a different collation on when.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-016.xsl"/></test>
      <result><assert-xml><![CDATA[<out>42</out>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-017">
      <description>Selector, test and result expressions retain the caller item, position and size.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-017.xsl"/></test>
      <result><assert-xml><![CDATA[<out><v item="10" position="1" size="2"/><after item="10" position="1" size="2"/><v item="20" position="2" size="2"/><after item="20" position="2" size="2"/></out>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-018">
      <description>A selected node sequence retains identity and explicitly reversed order.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-018.xsl"/></test>
      <result><assert-xml><![CDATA[<out count="2" first="B" same="true" last="A"/>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-019">
      <description>A selected function item is returned without atomization and remains callable.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-019.xsl"/></test>
      <result><assert-xml><![CDATA[<out value="42"/>]]></assert-xml></result>
   </test-case>

   <test-case name="switch-020">
      <description>An error in the selected result propagates without falling through to otherwise.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-020.xsl"/></test>
      <result><error code="FOER0000"/></result>
   </test-case>

   <test-case name="switch-021">
      <description>An earlier nonmatching result is not evaluated before the selected constructor.</description>
      <created by="Charles Korthout" on="2026-10-21"/>
      <dependencies><spec value="XSLT40+"/></dependencies>
      <test><stylesheet file="switch-021.xsl"/></test>
      <result><assert-xml><![CDATA[<out>42</out>]]></assert-xml></result>
   </test-case>
</test-set>
